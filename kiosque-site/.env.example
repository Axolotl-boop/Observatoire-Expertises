# --- Synchronisation SharePoint (GitHub Actions uniquement) ---------------
# Nécessaire seulement pour lancer `npm run sync` en local. Le site en lui-même
# ne lit aucune variable d'environnement : son contenu vient du dossier content/.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SHAREPOINT_HOST=<tenant>.sharepoint.com
SHAREPOINT_SITE=/sites/<MonSite>
# (optionnel) bibliothèque de documents, défaut « Documents »
SHAREPOINT_DRIVE=
# (optionnel) sous-dossier racine à parcourir
SHAREPOINT_FOLDER=
# (optionnel) ne garder que les chemins contenant cette chaîne.
# Défaut : « Newsletters-pré-digérées/ » — c'est ce qui restreint ce dépôt au kiosque.
SHAREPOINT_FILTER=

# --- Référencement (Vercel) ------------------------------------------------
# Indexation par les moteurs de recherche. Bloquée tant que ce n'est pas « true ».
NEXT_PUBLIC_ALLOW_INDEXING=false
